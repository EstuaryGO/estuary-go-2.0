{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to the downloadable PDF for this module"
    },
    "category": {
      "type": "string",
      "enum": [
        "GO! Prep Modules",
        "GO! Practices Modules",
        "GO! Guide Training"
      ]
    },
    "subcategory": {
      "type": "string",
      "description": "e.g. GO! Prep 1, GO! Prep 2, GO! Prep 3"
    },
    "module": {
      "type": "string",
      "description": "e.g. GO! Prep 1.1, GO! Prep 1.2, GO! Prep 1.3"
    },
    "duration_minutes": {
      "type": "number"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "video_url",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}