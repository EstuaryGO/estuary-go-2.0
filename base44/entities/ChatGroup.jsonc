{
  "name": "ChatGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "icon": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "All Participants",
        "Churches",
        "Groups"
      ],
      "default": "Churches"
    },
    "parent_church_id": {
      "type": "string",
      "description": "ID of the All Participants group (for Churches level groups)"
    },
    "parent_group_id": {
      "type": "string",
      "description": "ID of the Churches level group (for Groups level groups)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "data.members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}