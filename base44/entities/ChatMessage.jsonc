{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "content",
    "sender_email",
    "sender_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}